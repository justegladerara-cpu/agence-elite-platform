# Never set APP_ENV=production until launch gates and EC-025 are resolved.
APP_ENV=demo
SITE_URL=http://127.0.0.1:3000
# Local SQLite adapter: persistent, isolated by environment, demo only.
LOCAL_DATABASE_PATH=.data/demo.db
# Demo access is only available in development/demo, never staging/production.
DEMO_EDITOR_PASSWORD=express-demo-local
# Future Supabase connection: non connected. Server secrets must never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# All capabilities requiring operator approval are disabled.
FEATURE_PRICING_ENGINE=false
FEATURE_VOLUMETRIC_WEIGHT=false
FEATURE_TRACKING=false
# Secret HMAC des codes de suivi public (32 caractères minimum). Obligatoire hors
# démonstration ; en démonstration un secret public de test est utilisé.
TRACKING_SECRET=
FEATURE_CLIENT_ACCOUNTS=false
FEATURE_PICKUP=false
FEATURE_HOME_DELIVERY=false
FEATURE_ONLINE_PAYMENT=false
FEATURE_NOTIFY_EMAIL=false
FEATURE_NOTIFY_SMS=false
FEATURE_NOTIFY_WHATSAPP=false
FEATURE_TESTIMONIALS=false
FEATURE_XAF_DISPLAY=false
ROUTES_ENABLED=FR-CG
# Empty until chosen and verified. No real message is sent by this release.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
# Paiement en ligne : secrets du Worker Cloudflare, jamais commités.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
DOCUMENT_SCANNER_URL=
VOLUMETRIC_DIVISOR=
XAF_RATE=
XAF_RATE_SOURCE=
# Playwright uses an installed Chrome; use msedge if needed.
PLAYWRIGHT_CHANNEL=chrome
