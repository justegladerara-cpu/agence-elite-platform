# Copier en .env.local (jamais commité). Sans ces variables, l'application tourne
# en mode local (base dans le navigateur, démo fictive).

# Supabase local (npx supabase start affiche ces deux valeurs)
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=clé-publique-anon

# Production (à régler dans Cloudflare Pages, pas dans ce fichier) :
# VITE_SUPABASE_URL=https://<identifiant-projet>.supabase.co
# VITE_SUPABASE_ANON_KEY=<clé publique "anon" / "publishable" du projet>
# VITE_AUTORISER_SUPABASE_DISTANT=oui
